# Copy these into Render's "Environment" settings with your real values.
# For running locally, copy this file to .env and fill it in.

# Postgres connection (Render: Internal Database URL for the app,
# External Database URL when running `npm run seed` from your computer)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to false only for a local database without SSL
PGSSL=true

# Shown on pages, emails and PDF quotes
COMPANY_NAME=Your Company Name

# Admin dashboard password (/admin/login). Pick something strong.
ADMIN_PASSWORD=change-this-password
# A long random string, used to sign login cookies
SESSION_SECRET=replace-with-a-long-random-string

# Email (Resend). Leave RESEND_API_KEY blank to skip sending while testing.
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
# Where new-order emails go
ADMIN_EMAIL=you@example.com
