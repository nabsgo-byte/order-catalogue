<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= companyName %> — Order Catalog</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card" style="max-width:420px; margin: 60px auto; text-align:center;">
    <img src="/logo.png" alt="<%= companyName %>" style="max-width:180px; margin-bottom:16px;">
    <p class="muted" style="text-align:left">Enter your name to view the catalog and order.</p>
    <% if (error) { %><p style="color:#b00">
<%= error %></p><% } %>
    <form method="post" action="/start">
      <div class="row">
        <input type="text" name="name" placeholder="Your full name" required style="flex:1">
        <button type="submit">Continue</button>
      </div>
    </form>
  </div>
</body>
</html>
