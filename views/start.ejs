<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= companyName %> — Order Catalog</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card" style="max-width:420px; margin: 60px auto;">
    <h1><%= companyName %></h1>
    <p class="muted">Enter your name to view the catalog and order.</p>
    <% if (error) { %><p style="color:#b00">
<%= error %></p><% } %>
    <form method="post" action="/start">
      <div class="row">
        <input type="text" name="name" placeholder="Your full name" required style="flex:1">
        <button type="submit">Continue</button>
      </div>
    </form>
  </div>
</body>
</html>
