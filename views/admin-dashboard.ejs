<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Admin — <%= companyName %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="topbar">
    <h1>Admin</h1>
    <a class="btn btn-secondary" href="/admin/logout">Log out</a>
  </div>

  <div class="row">
    <div class="card" style="flex:1"><span class="badge">Customers</span><h2><%= counts.customers %></h2><a href="/admin/customers">View all &amp; export CSV</a></div>
    <div class="card" style="flex:1"><span class="badge">Products</span><h2><%= counts.products %></h2><span class="muted">Re-run <code>npm run seed</code> to update prices</span></div>
    <div class="card" style="flex:1"><span class="badge">Orders</span><h2><%= counts.orders %></h2><a href="/admin/orders">View all &amp; export CSV</a></div>
  </div>

  <div class="card">
    <h2>Recent orders</h2>
    <table>
      <tr><th>#</th><th>Customer</th><th>Date</th><th>Total</th><th></th></tr>
      <% recentOrders.forEach(o => { %>
        <tr>
          <td><%= o.id %></td>
          <td><%= o.customer_name %></td>
          <td><%= new Date(o.created_at).toLocaleString() %></td>
          <td>$<%= Number(o.total).toFixed(2) %></td>
          <td><a href="/quote/<%= o.id %>/pdf?admin=1">PDF</a></td>
        </tr>
      <% }) %>
    </table>
  </div>
</body>
</html>
