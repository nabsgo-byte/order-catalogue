<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Catalog — <%= companyName %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="topbar">
    <div>
      <h1 style="margin-bottom:0"><%= companyName %></h1>
      <span class="muted">Signed in as <%= customerName %> — <a href="/logout">not you?</a></span>
    </div>
    <a class="btn" href="/cart">Cart (<%= cartCount %>)</a>
  </div>

  <form method="get" action="/catalog" class="row" style="margin-bottom:16px">
    <input type="text" name="q" value="<%= q %>" placeholder="Search by name or product code..." style="flex:1">
    <button type="submit">Search</button>
    <% if (q) { %><a class="btn btn-secondary" href="/catalog">Clear</a><% } %>
  </form>

  <div class="row" style="justify-content:space-between">
    <% if (!q) { %>
      <p class="muted">Showing <%= totalCount === 0 ? 0 : ((page - 1) * 50 + 1) %>–<%= Math.min(page * 50, totalCount) %> of <%= totalCount %> products.</p>
    <% } else { %>
      <p class="muted"><%= totalCount %> result(s) for "<%= q %>" — page <%= page %> of <%= totalPages %></p>
    <% } %>
    <% if (totalPages > 1) { %>
      <div class="row" style="gap:6px">
        <% if (page > 1) { %>
          <a class="btn btn-secondary" href="/catalog?page=<%= page - 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">&larr; Prev</a>
        <% } %>
        <span class="muted">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a class="btn btn-secondary" href="/catalog?page=<%= page + 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">Next &rarr;</a>
        <% } %>
      </div>
    <% } %>
  </div>

  <table>
    <tr><th></th><th>Code</th><th>Description</th><th>Unit</th><th>Price</th><th></th></tr>
    <% products.forEach(p => { %>
      <tr>
        <td>
          <% if (p.has_image) { %>
            <img class="thumb" src="/images/<%= p.product_code %>" alt="<%= p.product_code %>">
          <% } else { %>
            <span class="thumb-placeholder">no photo</span>
          <% } %>
        </td>
        <td><%= p.product_code %></td>
        <td><%= p.description %></td>
        <td><%= p.unit_of_measure %></td>
        <td>$<%= Number(p.unit_price).toFixed(2) %></td>
        <td>
          <form method="post" action="/cart/add" class="row" style="gap:4px">
            <input type="hidden" name="productId" value="<%= p.id %>">
            <input type="hidden" name="q" value="<%= q %>">
            <input type="hidden" name="page" value="<%= page %>">
            <input type="number" name="qty" value="1" min="1" class="qty-input">
            <button type="submit">Add</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>

  <% if (totalPages > 1) { %>
    <div class="row" style="gap:6px; justify-content:center; margin-top:16px">
      <% if (page > 1) { %>
        <a class="btn btn-secondary" href="/catalog?page=<%= page - 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">&larr; Prev</a>
      <% } %>
      <span class="muted">Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %>
        <a class="btn btn-secondary" href="/catalog?page=<%= page + 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">Next &rarr;</a>
      <% } %>
    </div>
  <% } %>
</body>
</html>
