<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Catalog — <%= companyName %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="topbar">
    <div>
      <h1 style="margin-bottom:0"><%= companyName %></h1>
      <span class="muted">Signed in as <%= customerName %> — <a href="/logout">not you?</a></span>
    </div>
    <a class="btn" href="/cart">Cart (<%= cartCount %>)</a>
  </div>

  <form method="get" action="/catalog" class="row" style="margin-bottom:16px">
    <input type="text" name="q" value="<%= q %>" placeholder="Search by name or product code..." style="flex:1">
    <button type="submit">Search</button>
    <% if (q) { %><a class="btn btn-secondary" href="/catalog">Clear</a><% } %>
  </form>

  <% if (!q) { %>
    <p class="muted">Showing the first 50 of <%= totalCount %> products. Use search to find more.</p>
  <% } else { %>
    <p class="muted"><%= products.length %> result(s) for "<%= q %>"</p>
  <% } %>

  <table>
    <tr><th></th><th>Code</th><th>Description</th><th>Unit</th><th>Price</th><th></th></tr>
    <% products.forEach(p => { %>
      <tr>
        <td>
          <% if (p.has_image) { %>
            <img class="thumb" src="/images/<%= p.product_code %>" alt="<%= p.product_code %>">
          <% } else { %>
            <span class="thumb-placeholder">no photo</span>
          <% } %>
        </td>
        <td><%= p.product_code %></td>
        <td><%= p.description %></td>
        <td><%= p.unit_of_measure %></td>
        <td>$<%= Number(p.unit_price).toFixed(2) %></td>
        <td>
          <form method="post" action="/cart/add" class="row" style="gap:4px">
            <input type="hidden" name="productId" value="<%= p.id %>">
            <input type="hidden" name="q" value="<%= q %>">
            <input type="number" name="qty" value="1" min="1" class="qty-input">
            <button type="submit">Add</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
